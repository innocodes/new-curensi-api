# App
APP_ENV=development
SECRET_KEY=change-this-to-a-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------
# Database
# Local dev  → uses the postgres container in docker-compose.yml
# Production → use your Neon DB URLs (see .env.production.example)
# ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://curensi:curensi@db:5432/curensi
DATABASE_URL_SYNC=postgresql+psycopg2://curensi:curensi@db:5432/curensi

# Redis
# Local dev  → uses the redis container in docker-compose.yml
# Production → use your Railway Redis internal URL
REDIS_URL=redis://redis:6379/0

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# LianLian Global
LIANLIAN_APP_ID=your-app-id
LIANLIAN_MERCHANT_ID=your-merchant-id
LIANLIAN_API_KEY=your-api-key
LIANLIAN_WEBHOOK_SECRET=your-lianlian-webhook-secret
LIANLIAN_BASE_URL=https://sandbox.lianlianpay.com

# Firebase (FCM push notifications — leave as {} to disable locally)
FIREBASE_SERVICE_ACCOUNT_KEY={}

# CORS — add localhost ports you use during web dev
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Future providers (uncomment when needed)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
