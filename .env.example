# App
APP_ENV=development
SECRET_KEY=change-this-to-a-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Neon DB
# Use pooled URL for the app, direct URL for Alembic migrations
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/curensi?sslmode=require
DATABASE_URL_SYNC=postgresql+psycopg2://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/curensi?sslmode=require

# Redis (local dev: redis://localhost:6379/0 | Railway: injected automatically)
REDIS_URL=redis://localhost:6379/0

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxx
FLUTTERWAVE_WEBHOOK_SECRET=your-flutterwave-webhook-secret
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# LianLian Global
LIANLIAN_APP_ID=your-app-id
LIANLIAN_MERCHANT_ID=your-merchant-id
LIANLIAN_API_KEY=your-api-key
LIANLIAN_WEBHOOK_SECRET=your-lianlian-webhook-secret
LIANLIAN_BASE_URL=https://sandbox.lianlianpay.com

# Firebase (FCM push notifications)
# Path to your downloaded serviceAccountKey.json, or paste the JSON string
FIREBASE_SERVICE_ACCOUNT_KEY={}

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://curensi.app

# Future providers (uncomment when needed)
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# AIRWALLEX_CLIENT_ID=
# AIRWALLEX_API_KEY=
